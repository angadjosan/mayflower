# Claude (LLM) — https://platform.claude.com
# To run on Kimi instead of Claude (Moonshot speaks the Anthropic API):
#   ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic  ANTHROPIC_API_KEY=<moonshot key>
#   ANTHROPIC_MODEL=kimi-k3  ANTHROPIC_FAST_MODEL=kimi-k2.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Small model for intent routing, profile extraction, market ranking and the critic (keeps iMessage replies fast)
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# Gemini Exchange prediction markets (sandbox). Leave blank to run in clearly-labeled simulated mode.
GEMINI_EXCHANGE_API_KEY=
GEMINI_EXCHANGE_API_SECRET=
GEMINI_EXCHANGE_BASE_URL=https://api.sandbox.gemini.com
# Sub-account name (required for master API keys)
GEMINI_EXCHANGE_ACCOUNT=primary
# Nonce mode the API key was created with: blank = incremental (ms), "seconds" = time-based
GEMINI_EXCHANGE_NONCE=
# 1 = also discover production markets (sports, politics) from public data. Sandbox can't trade them,
# so their orders are always simulated and labeled paper-only. Sandbox itself only lists crypto/commodities.
GEMINI_DISCOVERY_INCLUDE_PRODUCTION=

# Paper bankroll each venue reports while simulated (default 100000). Trade sizes are still capped by user risk limits.
SIMULATED_BALANCE_USD=

# Fallback venues: used only for markets Gemini doesn't list (priority Gemini > Polymarket > Hyperliquid).
# Discovery uses public data and is on by default; without keys, orders there are simulated and labeled.

# Polymarket (no sandbox: live orders move real USDC on Polygon). 0 = disable entirely.
POLYMARKET_ENABLED=
# Wallet key that signs orders. Orders stay simulated unless POLYMARKET_LIVE_TRADING=1 too.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_LIVE_TRADING=
# 0 = EOA holds funds (default), 1 = Polymarket email/Magic proxy, 2 = browser-wallet Safe proxy
POLYMARKET_SIGNATURE_TYPE=
# Proxy wallet address holding the USDC (required for signature types 1/2)
POLYMARKET_FUNDER_ADDRESS=
# Optional CLOB API creds; derived from the private key when blank
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Hyperliquid HIP-4 outcome markets. 0 = disable entirely.
HYPERLIQUID_ENABLED=
# testnet (default) | mainnet. Mainnet orders also need HYPERLIQUID_LIVE_TRADING=1.
HYPERLIQUID_NETWORK=testnet
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_LIVE_TRADING=
# Master account address when HYPERLIQUID_PRIVATE_KEY is an API (agent) wallet
HYPERLIQUID_ACCOUNT_ADDRESS=
# 1 = on testnet, also discover mainnet outcomes as paper-only
HYPERLIQUID_DISCOVERY_INCLUDE_MAINNET=

# Context.dev research
CONTEXT_DEV_API_KEY=
CONTEXT_DEV_BASE_URL=https://api.context.dev

# BlueBubbles (iMessage)
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
BLUEBUBBLES_WEBHOOK_SECRET=
ALLOW_GROUP_CHATS=                # "1" to reply inside group chats (off by default)

# Public base URL used in iMessage approval links
APP_URL=http://localhost:3000
# Shared secret for /api/cron/monitor
CRON_SECRET=

# Discord (second chat surface) — see docs/DISCORD.md
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Shared secret between scripts/discord-bot.mjs and /api/discord/inbound
DISCORD_INBOUND_SECRET=

# Personal context connectors (optional; see docs/INTEGRATIONS.md)
# 32 random bytes, base64 or hex (openssl rand -base64 32). Encrypts connector tokens at rest.
MAYFLOWER_ENCRYPTION_KEY=
# Notion: public OAuth integration (client id/secret) OR an internal integration token
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_TOKEN=
# Slack: OAuth v2 user-token app
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Gmail: Google OAuth web client (gmail.readonly)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# YZi: BNB Smart Chain testnet audit receipts (only a sha256 hash goes onchain). Blank = receipts recorded offchain, status "disabled".
# Use a throwaway testnet-only key funded from the BSC testnet faucet. Never a mainnet key.
BNB_TESTNET_PRIVATE_KEY=
BNB_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# ElevenLabs: iMessage voice notes (voice memos in, spoken replies out) and phone calls. See docs/VOICE.md
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=              # blank = default voice; list yours with GET https://api.elevenlabs.io/v1/voices
ELEVENLABS_TTS_MODEL=             # blank = eleven_flash_v2_5 (lowest latency)
ELEVENLABS_STT_MODEL=             # blank = scribe_v2
ELEVENLABS_AGENT_ID=
# Shared secret sent by ElevenLabs server tools as x-mayflower-voice-secret (required to enable /api/voice/tools/*)
ELEVENLABS_TOOL_SECRET=

# Sentry (enabled only when a DSN is set; source maps upload only with SENTRY_AUTH_TOKEN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Trigger.dev (scheduled monitor calls ${APP_URL}/api/cron/monitor; set APP_URL + CRON_SECRET in Trigger.dev env too)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Gemini OAuth (Plan A, per-user trade-only linking). Leave blank to use Plan B (shared sandbox API key above).
# Register at https://exchange.sandbox.gemini.com/settings/api with redirect URI ${APP_URL}/api/gemini-oauth/callback
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
# Optional overrides: OAuth host (defaults to exchange.sandbox.gemini.com when GEMINI_EXCHANGE_BASE_URL is sandbox) and redirect URI
GEMINI_OAUTH_BASE_URL=
GEMINI_OAUTH_REDIRECT_URI=

# Signs dashboard session cookies. Required for `next start` / production (openssl rand -base64 32)
SESSION_SECRET=
# Signed-out visitors fall back to the demo user only on http://localhost (never through a tunnel). 1 = always allow (unsafe when public)
ALLOW_DEMO_USER=

# Supabase (Project Settings → API Keys). Secret key is server-only; publishable key is unused for now.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Session pooler URI, for CI migrations only
SUPABASE_DB_URL=
