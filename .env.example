# ---- App ---------------------------------------------------------------------
APP_URL=http://localhost:3000
# Required in production. Any long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Required in production: 32 bytes (64 hex chars) used to encrypt Gemini OAuth tokens at rest.
ENCRYPTION_KEY=
# Protects /api/cron/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
# Comma-separated iMessage handles allowed to flip the global kill switch.
ADMIN_HANDLES=
# Global kill switch: set to false to block ALL order submission.
MAYFLOWER_TRADING_ENABLED=true

# ---- Offline demo ---------------------------------------------------------------
# true = use the labelled DEMO market catalog + demo evidence (no network needed). Never real markets.
MAYFLOWER_DEMO_MODE=false
# Show iMessage sign-in codes on screen when BlueBubbles isn't configured (defaults to on outside production).
MAYFLOWER_DEV_LOGIN=

# ---- Database (Supabase Postgres) ----------------------------------------------
# Leave empty to use embedded PGlite in .data/pglite (local dev). For Supabase use the pooler URI.
DATABASE_URL=
DB_AUTO_MIGRATE=false

# ---- Gemini Exchange (prediction markets) ---------------------------------------
GEMINI_ENV=sandbox
# Plan A: users link their own account with trade-only OAuth.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
# Plan B (sandbox only): one shared team API key; per-user allocation tracked in the ledger.
GEMINI_API_KEY=
GEMINI_API_SECRET=
GEMINI_ACCOUNT=
SANDBOX_ALLOCATION_USD=1000
ORDER_TIME_IN_FORCE=good-til-cancel
ESTIMATED_FEE_PER_CONTRACT=0.01

# ---- Context.dev (research) -----------------------------------------------------
CONTEXT_DEV_API_KEY=

# ---- Google Gemini (LLM reasoning — not the exchange) ---------------------------
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-flash-latest

# ---- iMessage via BlueBubbles ---------------------------------------------------
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
# Webhook URL to configure in BlueBubbles: $APP_URL/api/imessage/webhook?secret=$BLUEBUBBLES_WEBHOOK_SECRET
BLUEBUBBLES_WEBHOOK_SECRET=
BLUEBUBBLES_SEND_METHOD=apple-script
IMESSAGE_CODE_APPROVAL=true
APPROVAL_LINK_MINUTES=15
PROPOSAL_TTL_HOURS=12
