# Copy to .env at the repo root. Every key is optional: a missing key puts that
# integration in its labeled fallback mode (see GET /health and the dashboard strip).

# --- Worker ---
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787        # public tunnel/Railway URL once deployed
DASHBOARD_URL=http://localhost:3000          # case links in every text point here
DATABASE_URL=                                # Supabase Postgres URL; empty = local PGlite in .data/pglite
RECORD_TICKS=1                               # record the Gemini trade stream (Radar needs this from hour one)

# --- Gemini Exchange (prediction markets SANDBOX). Empty = SIMULATED fills ---
GEMINI_SANDBOX_API_KEY=
GEMINI_SANDBOX_API_SECRET=

# --- Google Gemini LLM. Empty = fake brain (keyword matcher, forecast = market price) ---
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_FAST_MODEL=gemini-3.5-flash-lite

# --- Context.dev research. Empty = no sources (weight stays at the 0.2 floor) ---
CONTEXT_DEV_API_KEY=

# --- iMessage via BlueBubbles. Empty = console messenger (replies print in the worker log) ---
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
WEBHOOK_SECRET=                              # REQUIRED once BlueBubbles is set: random 24+ chars
ALLOWED_SENDERS=                             # comma-separated phones/emails the bot answers; * = everyone, empty = nobody

# --- ElevenLabs voice. Empty = no voice memos / voice notes ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Risk engine knobs ---
RISK_SAFETY_MARGIN=0.05
RISK_KELLY_FRACTION=0.25
PROPOSAL_TTL_MINUTES=10

# Dev only: with no LLM key, shift the fake forecast to exercise the edge + APPROVE path
# FAKE_FORECAST_DELTA=0.6
