# Claude (LLM) — https://platform.claude.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# Gemini Exchange prediction markets (sandbox). Leave blank to run in clearly-labeled simulated mode.
GEMINI_EXCHANGE_API_KEY=
GEMINI_EXCHANGE_API_SECRET=
GEMINI_EXCHANGE_BASE_URL=https://api.sandbox.gemini.com
# Sub-account name (required for master API keys)
GEMINI_EXCHANGE_ACCOUNT=primary

# Context.dev research
CONTEXT_DEV_API_KEY=
CONTEXT_DEV_BASE_URL=https://api.context.dev

# BlueBubbles (iMessage)
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
BLUEBUBBLES_WEBHOOK_SECRET=

# Public base URL used in iMessage approval links
APP_URL=http://localhost:3000
# Shared secret for /api/cron/monitor
CRON_SECRET=

# Discord (second chat surface) — see docs/DISCORD.md
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Shared secret between scripts/discord-bot.mjs and /api/discord/inbound
DISCORD_INBOUND_SECRET=

# Personal context connectors (optional; see docs/INTEGRATIONS.md)
# 32 random bytes, base64 or hex (openssl rand -base64 32). Encrypts connector tokens at rest.
MAYFLOWER_ENCRYPTION_KEY=
# Notion: public OAuth integration (client id/secret) OR an internal integration token
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_TOKEN=
# Slack: OAuth v2 user-token app
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Gmail: Google OAuth web client (gmail.readonly)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# YZi: BNB Smart Chain testnet audit receipts (only a sha256 hash goes onchain). Blank = receipts recorded offchain, status "disabled".
# Use a throwaway testnet-only key funded from the BSC testnet faucet. Never a mainnet key.
BNB_TESTNET_PRIVATE_KEY=
BNB_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# ElevenLabs phone calls (inbound only) — see docs/VOICE.md
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Shared secret sent by ElevenLabs server tools as x-mayflower-voice-secret (required to enable /api/voice/tools/*)
ELEVENLABS_TOOL_SECRET=

# Sentry (enabled only when a DSN is set; source maps upload only with SENTRY_AUTH_TOKEN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Trigger.dev (scheduled monitor calls ${APP_URL}/api/cron/monitor; set APP_URL + CRON_SECRET in Trigger.dev env too)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Gemini OAuth (Plan A, per-user trade-only linking). Leave blank to use Plan B (shared sandbox API key above).
# Register at https://exchange.sandbox.gemini.com/settings/api with redirect URI ${APP_URL}/api/gemini-oauth/callback
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
# Optional overrides: OAuth host (defaults to exchange.sandbox.gemini.com when GEMINI_EXCHANGE_BASE_URL is sandbox) and redirect URI
GEMINI_OAUTH_BASE_URL=
GEMINI_OAUTH_REDIRECT_URI=
